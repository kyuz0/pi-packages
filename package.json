{
  "name": "pi-packages",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Auto-review, OS sandbox and statusline extensions for Pi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erichll/pi-packages.git"
  },
  "keywords": [
    "pi-package",
    "pi",
    "sandbox",
    "security"
  ],
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "pi": {
    "extensions": [
      "./packages/pi-auto-review/src/index.ts",
      "./packages/pi-sandbox/src/index.ts",
      "./packages/pi-statusline/src/index.ts"
    ]
  },
  "scripts": {
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "gate:pi-subagents": "node --experimental-strip-types scripts/pi-subagents-compat-gate.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "jiti": "^2.7.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.79",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@gotgenes/pi-permission-system": "40.2.0",
    "@mariozechner/pi-coding-agent": "npm:@earendil-works/pi-coding-agent@1.2.0",
    "@mariozechner/pi-tui": "npm:@earendil-works/pi-tui@1.2.0",
    "jiti": "2.7.0",
    "pi-goal": "0.1.7",
    "pi-schedule-prompt": "0.4.1",
    "pi-subagents": "0.78.0",
    "typebox": "1.3.37"
  }
}
