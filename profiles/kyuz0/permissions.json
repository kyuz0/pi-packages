{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "authorizerChain": [
    "pi-auto-review"
  ],
  "permission": {
    "*": "ask",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.ssh/*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*.jks": "deny",
      "*.keystore": "deny",
      ".envrc": "deny",
      ".npmrc": "deny",
      ".pypirc": "deny",
      ".netrc": "deny",
      ".git-credentials": "deny",
      "id_rsa": "deny",
      "id_ed25519": "deny",
      "~/.aws/*": "deny",
      "~/.kube/*": "deny",
      "~/.config/gcloud/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.docker/config.json": "deny",
      "~/.config/gh/hosts.yml": "deny",
      "~/.azure/*": "deny",
      "~/.pi/agent/auth.json": "deny"
    },
    "external_directory": {
      "*": "ask"
    },
    "bash": {
      "*": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "less *": "allow",
      "more *": "allow",
      "echo *": "allow",
      "ls *": "allow",
      "tree *": "allow",
      "stat *": "allow",
      "file *": "allow",
      "wc *": "allow",
      "du *": "allow",
      "df *": "allow",
      "pwd": "allow",
      "whoami": "allow",
      "id": "allow",
      "hostname": "allow",
      "uname *": "allow",
      "date": "allow",
      "uptime": "allow",
      "ps *": "allow",
      "printenv *": "allow",
      "which *": "allow",
      "type *": "allow",
      "grep *": "allow",
      "egrep *": "allow",
      "fgrep *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "fd *": "allow",
      "git status": "allow",
      "git diff": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git add *": "allow",
      "git commit*": "allow",
      "git branch*": "allow",
      "git switch*": "allow",
      "git checkout*": "allow",
      "npm test*": "allow",
      "npm run test*": "allow",
      "npm run check*": "allow",
      "npm run build*": "allow",
      "npm run lint*": "allow",
      "npm install*": "allow",
      "npm ci*": "allow",
      "pnpm test*": "allow",
      "pnpm run test*": "allow",
      "pnpm run check*": "allow",
      "pnpm run build*": "allow",
      "pnpm run lint*": "allow",
      "pnpm install*": "allow",
      "yarn test*": "allow",
      "yarn build*": "allow",
      "yarn lint*": "allow",
      "yarn install*": "allow",
      "cargo test*": "allow",
      "cargo check*": "allow",
      "cargo build*": "allow",
      "cmake --build *": "allow",
      "cmake -S *": "allow",
      "make": "allow",
      "make *": "allow",
      "ninja": "allow",
      "ninja *": "allow",
      "pytest*": "allow",
      "python -m pytest*": "allow",
      "python3 -m pytest*": "allow",
      "node --test*": "allow",
      "bun test*": "allow",
      "pip install*": "allow",
      "pip3 install*": "allow",
      "uv sync*": "allow",
      "git push*": "ask",
      "git reset --hard*": "ask",
      "git clean -fd*": "ask",
      "npm publish*": "ask",
      "pnpm publish*": "ask",
      "yarn publish*": "ask",
      "cargo publish*": "ask",
      "gh pr create*": "ask",
      "gh pr merge*": "ask",
      "gh release *": "ask",
      "gh api *": "ask"
    },
    "skill": {
      "*": "ask"
    },
    "read": "allow",
    "write": "allow",
    "edit": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "ask_user": "allow",
    "todo": "allow",
    "update_plan": "allow",
    "plan_mode_question": "allow",
    "plan_mode_complete": "allow",
    "goal_complete": "allow",
    "goal_blocked": "allow",
    "goal_wait": "allow",
    "obs_recall": "allow",
    "bg_wait": "allow",
    "bash_escalate": "allow",
    "slack_list_channels": "allow",
    "slack_read_messages": "allow",
    "slack_read_thread": "allow",
    "slack_search": "allow",
    "slack_download_file": "allow",
    "slack_post_message": "allow",
    "slack_edit_message": "allow",
    "slack_delete_message": "allow",
    "schedule_prompt": "allow",
    "advisor_ask": "allow",
    "advisor_status": "allow"
  },
  "yoloMode": false,
  "permissionReviewLog": true
}
