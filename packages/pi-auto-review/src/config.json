{
  "model": "codex-auto-review",
  "reasoning": "low",
  "timeoutMs": 600000,
  "maxTokens": 4096,
  "retries": 2,
  "maxUserTranscriptTokens": 1200,
  "maxToolTranscriptTokens": 1200,
  "maxRelevantResultTokens": 800,
  "maxReviewerInputTokens": 8192,
  "breakGlassEnabled": true,
  "failureMode": "deny",
  "grantTtlMs": 60000,
  "autoConfirmBoundedAllows": [
    "external_directory",
    "path"
  ],
  "policyAudit": {
    "enabled": true,
    "retentionDays": 180
  },
  "retainedContext": true,
  "reviewerConversation": true,
  "investigationTools": false
}
